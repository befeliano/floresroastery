# Flores Roastery — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın (Hostinger'da: Node.js uygulaması → Ortam değişkenleri).
# NEXT_PUBLIC_ öneki OLMAYAN hiçbir değer tarayıcıya gönderilmez.

# Sitenin canlı adresi (sitemap, canonical, OpenGraph, kutu QR kodları)
NEXT_PUBLIC_SITE_URL=https://floresroastery.com

# WordPress + WooCommerce adresi (yönetim paneli). Fiyat/stok buradan okunur.
WOOCOMMERCE_URL=https://panel.floresroastery.com
# WooCommerce → Ayarlar → Gelişmiş → REST API (Okuma/Yazma) — siparişleri WooCommerce'e yazar,
# kartla ödemeyi (WordPress'teki iyzico eklentisi) ve kuponları etkinleştirir
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# WooCommerce webhook → /api/revalidate?secret=...
REVALIDATE_SECRET=

# (İsteğe bağlı) Üye oturum çerezini imzalayan anahtar — en az 32 karakter rastgele değer.
# Boş bırakılırsa WooCommerce consumer secret'ından türetilir.
SESSION_SECRET=

# iyzico — kartla ödeme DOĞRUDAN iyzico ödeme sayfasında (WordPress'e gerek kalmaz).
# iyzico üye işyeri paneli → Ayarlar → Firma Ayarları: API Anahtarı ve Güvenlik Anahtarı.
# Önce test: IYZICO_BASE_URL=https://sandbox-api.iyzipay.com + sandbox anahtarları; sonra canlı adres ve canlı anahtarlar.
# Boş bırakılırsa kartlı ödeme WordPress'teki iyzico eklentisinden alınır (eski yöntem).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
